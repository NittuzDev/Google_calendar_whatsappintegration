[Unit]
Description=Promemoria WhatsApp da Google Calendar
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=reminder
Group=reminder
WorkingDirectory=/opt/whatsapp-reminder
EnvironmentFile=/opt/whatsapp-reminder/.env
Environment=PUPPETEER_CACHE_DIR=/var/lib/whatsapp-reminder/puppeteer
# Impostare solo se Chrome for Testing non è nella cache di Puppeteer.
# Environment=CHROME_PATH=/var/lib/whatsapp-reminder/puppeteer/chrome/linux-146.0.7680.31/chrome-linux64/chrome
ExecStart=/usr/bin/node index.js
TimeoutStartSec=15min
Nice=10
